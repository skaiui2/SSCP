+uint32_t
+TcpCubic::PacingGrowth(Ptr<const TcpSocketState> tcb, uint32_t window) const
+{
+    const uint32_t mss = tcb->m_segmentSize;
+    const bool active = m_epochStart != Time::Min();
+    const uint64_t origin = active ? uint64_t(m_bicOriginPoint) * mss
+                                   : std::max<uint64_t>(window, uint64_t(m_lastMaxCwnd) * mss);
+    const double k = active ? m_bicK : std::cbrt((origin - window) / (m_c * mss));
+    const Time rtt = tcb->m_minRtt == Time::Max() ? tcb->m_srtt.Get() : tcb->m_minRtt;
+    const Time elapsed = active ? std::max(Time(), Simulator::Now() - m_epochStart) : Time();
+    const double t = (elapsed + rtt).GetSeconds() - k;
+    const uint64_t reno = active ? uint64_t(m_tcpCwnd) * mss : window;
+    const double target =
+        std::max(origin + m_c * mss * t * t * t,
+                 double(reno + (reno < origin ? 9U * mss / 17U : mss)));
+    if (target <= window)
+    {
+        return mss / 100U;
+    }
+    return static_cast<uint32_t>(std::min(target - window, double(window / 2)));
+}
