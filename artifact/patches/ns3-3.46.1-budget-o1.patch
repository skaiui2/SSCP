+    uint64_t rxBytes{0};
+    uint64_t txDataPackets{0};
+    uint64_t drops{0};
+    uint64_t tcDrops{0};
+    double firstData{-1.0};
+    double completeAt{-1.0};
+
+    void Row(const std::string& event,
+             uint32_t seq = 0,
+             uint32_t bytes = 0,
+             double v1 = 0.0,
+             double v2 = 0.0,
+             uint32_t flag = 0)
+    {
+        events << Simulator::Now().GetSeconds() << ',' << event << ',' << seq << ',' << bytes
+               << ',' << v1 << ',' << v2 << ',' << flag << '\n';
+    }
+};
+
+void
+Tx(Observation* observation,
+   Ptr<const Packet> packet,
+   const TcpHeader& header,
+   Ptr<const TcpSocketBase> socket)
+{
+    (void)socket;
+    observation->Row("tx",
+                     header.GetSequenceNumber().GetValue(),
+                     packet->GetSize(),
+                     header.GetAckNumber().GetValue(),
+                     0.0,
+                     header.GetFlags());
+    if (packet->GetSize() != 0)
+    {
+        ++observation->txDataPackets;
+        if (observation->firstData < 0)
+        {
+            observation->firstData = Simulator::Now().GetSeconds();
+        }
+    }
+}
+
+void
+Rx(Observation* observation,
+   Ptr<const Packet> packet,
+   const TcpHeader& header,
+   Ptr<const TcpSocketBase> socket)
+{
+    (void)socket;
+    observation->Row((header.GetFlags() & TcpHeader::ACK) ? "rx_ack" : "rx_control",
+                     header.GetAckNumber().GetValue(),
+                     packet->GetSize(),
+                     header.GetSequenceNumber().GetValue(),
+                     0.0,
+                     header.GetFlags());
+}
+
+void
+Uint(Observation* observation, std::string event, uint32_t oldValue, uint32_t newValue)
+{
+    observation->Row(event, 0, 0, newValue, oldValue);
+}
+
+void
+Double(Observation* observation, std::string event, double oldValue, double newValue)
+{
+    observation->Row(event, 0, 0, newValue, oldValue);
+}
+
+void
+Rtt(Observation* observation, Time oldValue, Time newValue)
+{
+    observation->Row("srtt", 0, 0, newValue.GetSeconds(), oldValue.GetSeconds());
+}
+
+void
+Congestion(Observation* observation,
+           TcpSocketState::TcpCongState_t oldValue,
+           TcpSocketState::TcpCongState_t newValue)
+{
+    observation->Row("state", 0, 0, newValue, oldValue);
+}
+
+void
+Deliver(Observation* observation, Ptr<const Packet> packet, const Address& from)
+{
+    (void)from;
+    observation->rxBytes += packet->GetSize();
+    observation->Row("deliver", 0, packet->GetSize(), observation->rxBytes);
+    if (observation->completeAt < 0 && observation->rxBytes >= observation->target)
+    {
+        observation->completeAt = Simulator::Now().GetSeconds();
+    }
+}
+
+void
+Drop(Observation* observation, uint32_t direction, Ptr<const Packet> packet)
+{
+    ++observation->drops;
+    observation->Row("drop", 0, packet->GetSize(), direction);
+}
+
+void
+TcDrop(Observation* observation, uint32_t node, Ptr<const Packet> packet)
+{
+    ++observation->tcDrops;
+    observation->Row("tc_drop", 0, packet->GetSize(), node);
+}
+
+void
+Attach(Observation* observation, Ptr<BulkSendApplication> source)
+{
+    Ptr<Socket> socket = source->GetSocket();
+    NS_ABORT_MSG_IF(!socket, "BulkSend did not create its native TCP socket");
+    auto connect = [&](const std::string& name, const CallbackBase& callback) {
