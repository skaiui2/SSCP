+    connect("Tx", MakeBoundCallback(&Tx, observation));
+    connect("Rx", MakeBoundCallback(&Rx, observation));
+    connect("CongestionWindow", MakeBoundCallback(&Uint, observation, std::string("cwnd")));
+    connect("BytesInFlight", MakeBoundCallback(&Uint, observation, std::string("flight")));
+    connect("SlowStartThreshold", MakeBoundCallback(&Uint, observation, std::string("ssthresh")));
+    connect("CongState", MakeBoundCallback(&Congestion, observation));
+    connect("RTT", MakeBoundCallback(&Rtt, observation));
+    connect("BudgetGain", MakeBoundCallback(&Double, observation, std::string("gain")));
+}
