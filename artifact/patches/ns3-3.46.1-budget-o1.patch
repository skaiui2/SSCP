+uint64_t
+TcpSocketBase::PacingWork(SequenceNumber32 seq, uint32_t length) const
+{
+    const uint32_t cwnd = m_tcb->m_cWnd;
+    if (cwnd == 0 || length == 0)
+    {
+        return 0;
+    }
+
+    const uint32_t flight = seq - m_txBuffer->HeadSequence();
+    const uint32_t threshold = m_tcb->m_ssThresh;
+    const uint32_t ssRoom = threshold > cwnd ? threshold - cwnd : 0;
+    uint64_t window = cwnd;
+    uint64_t growth = length;
+    if (flight < ssRoom)
+    {
+        window += flight;
+    }
+    else
+    {
+        window += ssRoom;
+        const uint32_t dwRtt =
+            m_congestionControl ? m_congestionControl->PacingGrowth(m_tcb, window) : m_tcb->m_segmentSize;
+        window += uint64_t(flight - ssRoom) * dwRtt / window;
+        growth = uint64_t(length) * dwRtt / window;
+    }
+
+    const uint64_t rwnd = m_rWnd.Get();
+    const uint64_t next = window + growth;
+    if (next == 0)
+    {
+        return 0;
+    }
+    const uint64_t usable = std::min(rwnd, next) - std::min(rwnd, window);
+    return ((uint64_t(length) + usable) << 32) / next;
+}
+
+void
+TcpSocketBase::AckPacingWork(SequenceNumber32 ack)
+{
+    const Time now = Simulator::Now();
+    const Time srtt = m_tcb->m_srtt;
+    const auto state = m_tcb->m_congState.Get();
+    if ((state == TcpSocketState::CA_OPEN || state == TcpSocketState::CA_DISORDER) &&
+        srtt.IsStrictlyPositive() && now >= m_budgetNextTick)
+    {
+        const uint64_t gain = (m_pacingWorkSum + (1ULL << 15)) >> 16;
+        m_budgetGain = std::max<uint64_t>(gain, 65536) / 65536.0;
+        m_budgetNextTick = now + srtt;
+    }
+    while (!m_pacingWork.empty() && m_pacingWork.front().end <= ack)
+    {
+        const uint64_t work = m_pacingWork.front().work;
+        m_pacingWorkSum = (m_pacingWorkSum >= work) ? (m_pacingWorkSum - work) : 0;
+        m_pacingWork.pop_front();
+    }
+}
