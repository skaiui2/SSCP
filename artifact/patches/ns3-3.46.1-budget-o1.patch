+            << ",\n  \"queue_drops\": " << observation.drops
+            << ",\n  \"device_queue_drops\": " << observation.drops
+            << ",\n  \"tc_drops\": " << observation.tcDrops
+            << ",\n  \"total_drops\": " << observation.drops + observation.tcDrops
+            << ",\n  \"complete\": " << (complete ? "true" : "false")
+            << ",\n  \"fct_s\": ";
+    if (complete)
+    {
+        summary << observation.completeAt - APP_START;
+    }
+    else
+    {
+        summary << "null";
+    }
+    summary << ",\n  \"first_data_s\": ";
+    if (observation.firstData >= 0)
+    {
+        summary << observation.firstData;
+    }
+    else
+    {
+        summary << "null";
+    }
+    summary << ",\n  \"complete_at_s\": ";
+    if (complete)
+    {
+        summary << observation.completeAt;
+    }
+    else
+    {
+        summary << "null";
+    }
+    summary << ",\n  \"data_fct_s\": ";
+    if (complete && observation.firstData >= 0)
+    {
+        summary << observation.completeAt - observation.firstData;
+    }
+    else
+    {
+        summary << "null";
+    }
+    summary << ",\n  \"simulated_until_s\": " << Simulator::Now().GetSeconds() << "\n}\n";
+    std::cout << "complete=" << complete << " rx_bytes=" << observation.rxBytes
+              << " tx_data_packets=" << observation.txDataPackets
+              << " queue_drops=" << observation.drops << '\n';
+    std::cout << "tc_drops=" << observation.tcDrops
+              << " total_drops=" << observation.drops + observation.tcDrops << '\n';
+    Simulator::Destroy();
+    return complete ? 0 : 2;
+}
