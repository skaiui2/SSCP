+    switch (pacing_mode) {
+    case picoquic_pacing_mode_native_q2:
+        gain = slow_start ? 1.25 : 1.0;
+        break;
+    case picoquic_pacing_mode_static_1_0:
+        gain = 1.0;
+        break;
+    case picoquic_pacing_mode_rfc_2_0:
+        gain = slow_start ? 2.0 : 1.25;
+        break;
+    case picoquic_pacing_mode_analytical:
+        gain = slow_start ? PICOQUIC_ANALYTIC_SS_GAIN : 1.0;
+        break;
+    case picoquic_pacing_mode_linux_20_12:
