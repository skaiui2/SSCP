+/* Estimate one-RTT CUBIC window growth in bytes for pacing-budget prediction. */
+static uint64_t cubic_budget_growth(
+    picoquic_path_t const* path_x,
+    uint64_t window,
+    uint64_t current_time)
+{
+    picoquic_cubic_state_t const* s =
+        (picoquic_cubic_state_t const*)path_x->congestion_alg_state;
+    uint64_t mss = path_x->send_mtu;
+    uint64_t rtt = (path_x->rtt_min != 0) ? path_x->rtt_min : path_x->smoothed_rtt;
+    int active = (s->alg_state == picoquic_cubic_alg_congestion_avoidance);
+    double remembered = s->W_max * (double)mss;
+    double origin = active ? remembered : (((double)window > remembered) ? (double)window : remembered);
+    double k = active ? s->K :
+        ((origin > (double)window) ? cubic_root((origin - (double)window) / (PICOQUIC_CUBIC_C * (double)mss)) : 0.0);
+    uint64_t elapsed = (active && current_time > s->start_of_epoch) ? (current_time - s->start_of_epoch) : 0;
+    double t = ((double)elapsed + (double)rtt) / 1000000.0 - k;
+    double reno = active ? s->W_reno : (double)window;
+    double w_cubic = origin + PICOQUIC_CUBIC_C * (double)mss * t * t * t;
+    double w_reno = reno + (double)((reno < origin) ? (9 * mss / 17) : mss);
+    double target = (w_cubic > w_reno) ? w_cubic : w_reno;
+    double growth;
+    double max_growth;
+
+    if (target <= (double)window) {
+        return mss / 100;
+    }
+    growth = target - (double)window;
+    max_growth = (double)(window / 2);
+    return (uint64_t)((growth < max_growth) ? growth : max_growth);
+}
+
+/* Predict one-packet ACK-clocked pacing work in Q32.32 fixed-point. */
+static uint64_t cubic_pacing_work(
+    picoquic_path_t const* path_x,
+    size_t length,
+    uint64_t current_time)
+{
+    picoquic_cubic_state_t const* s =
+        (picoquic_cubic_state_t const*)path_x->congestion_alg_state;
+    uint64_t w = path_x->cwin;
+    uint64_t flight = path_x->bytes_in_transit;
+    uint64_t threshold = s->ssthresh;
+    uint64_t room = (threshold > w) ? (threshold - w) : 0;
+    uint64_t dw = (uint64_t)length;
+    uint64_t denom;
+
+    if (w == 0 || path_x->send_mtu == 0) {
+        return 0;
+    }
+
+    if (flight < room) {
+        w += flight;
+    }
+    else {
+        uint64_t growth;
+        w += room;
+        growth = cubic_budget_growth(path_x, w, current_time);
+        w += (flight - room) * growth / w;
+        dw = (uint64_t)length * growth / w;
+    }
+
+    /* QUIC MAX_DATA is cumulative stream/connection credit, not a path window. */
+    denom = w + dw;
+    return (denom > 0) ? (((uint64_t)length + dw) << 32) / denom : 0;
+}
